{
  "name": "codegraph-public-site",
  "private": true,
  "scripts": {
    "build:tailwind": "tailwindcss -i ./css/tailwind.css -o ./css/tailwind.min.css --minify && node ./scripts/normalize_tailwind_projection.mjs ./css/tailwind.min.css",
    "build:js": "terser js/main.js --compress --mangle --output js/main.min.js.tmp",
    "check:design-tokens-parity": "python scripts/check_design_system_contract.py --check design-tokens-parity",
    "check:component-contracts": "python scripts/check_design_system_contract.py --check component-contracts",
    "check:diagram-tokens": "python scripts/check_design_system_contract.py --check diagram-tokens",
    "check:public-shell": "python scripts/check_design_system_contract.py --check public-shell",
    "check:design-system": "python scripts/check_design_system_contract.py --check all"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "tailwindcss": "4.3.0",
    "terser": "5.49.2"
  }
}
